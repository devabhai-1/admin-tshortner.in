# GA4 numeric property ID (Admin → Property settings → Property ID)
GA4_PROPERTY_ID=469135333

# Default days for ?days=N (frontend initial load uses 5; older dates via start_date/end_date)
GA4_DEFAULT_DAYS=5
# How far back when days=all (default ~5 years)
GA4_LOOKBACK_DAYS=1825
# 0 = no max date-span check. Set e.g. 366 to enforce a cap.
GA4_MAX_RANGE_DAYS=0
# Per-request page size (smaller = more stable on slow/SSL flaky networks)
GA4_PAGE_SIZE=50000
# Per page call timeout
GA4_TIMEOUT_SEC=45
# Retries for transient SSL/timeout errors
GA4_RETRIES=4
GA4_RETRY_BASE_SLEEP_SEC=1.2

# Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://tshortner-in-default-rtdb.asia-southeast1.firebasedatabase.app
